# ── Nouveau projet Supabase (recommandé — voir docs/SUPABASE-FRESH-SETUP.md) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — Transaction pooler (port 6543), utilisé par l'app V2
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

NEXT_PUBLIC_APP_URL=https://ai-hub-cnb3.vercel.app
